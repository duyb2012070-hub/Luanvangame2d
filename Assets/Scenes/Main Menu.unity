  m_GameObject: {fileID: 206159140}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\tC\u1ED0T TRUY\u1EC6N K\u1EF7 Nguy\xEAn V\u1EE1 V\u1EE5n\n\n\tTh\u1EBF
    gi\u1EDBi m\xE0 b\u1EA1n bi\u1EBFt \u0111\xE3 tan bi\u1EBFn, thay th\u1EBF v\xE0o
    \u0111\xF3 l\xE0 m\u1ED9t th\u1EF1c t\u1EA1i xa l\u1EA1 v\xE0 \u0111\u1EA7y th\xF9
    ngh\u1ECBch, n\u01A1i m\u1EB7t \u0111\u1EA5t kh\xF4ng c\xF2n l\xE0 \u0111i\u1EC3m
    t\u1EF1a an to\xE0n m\xE0 l\xE0 m\u1ED9t m\xEA cung g\u1EADp gh\u1EC1nh, \u0111\u1EE9t
    g\xE3y. B\u1EA1n t\u1EC9nh d\u1EADy v\u1EDBi h\u01A1i th\u1EDF d\u1ED3n d\u1EADp,
    nh\u1EADn ra m\xECnh \u0111ang \u0111\u1EE9ng gi\u1EEFa m\u1ED9t v\xF9ng \u0111\u1EA5t
    k\u1EF3 qu\xE1i, n\u01A1i nh\u1EEFng h\u1EBBm n\xFAi s\xE2u ho\u1EAFm v\xE0 v\u1EF1c
    th\u1EB3m \u0111en ng\xF2m ch\u1EF1c ch\u1EDD nu\u1ED1t ch\u1EEDng b\u1EA5t c\u1EE9
    ai s\u1EA9y ch\xE2n. \n\tPh\xEDa sau b\u1EA1n, m\u1ED9t \xE1p l\u1EF1c v\xF4
    h\xECnh t\u1EEB h\u01B0 kh\xF4ng \u0111ang b\u1EE7a v\xE2y, bu\u1ED9c b\u1EA1n
    ph\u1EA3i lao \u0111i. \u0110\u1ED9ng l\u1EF1c duy nh\u1EA5t l\xFAc n\xE0y kh\xF4ng
    ph\u1EA3i l\xE0 ch\u1EA1y tr\u1ED1n, m\xE0 l\xE0 t\xECm ki\u1EBFm m\u1ED9t \u0110\xEDch
    \u0110\u1EBFn Cu\u1ED1i C\xF9ng \u2013 n\u01A1i duy nh\u1EA5t m\xE0 \xE1nh s\xE1ng
    c\u1EE7a s\u1EF1 s\u1ED1ng c\xF2n t\u1ED3n t\u1EA1i, m\u1ED9t \u0111i\u1EC3m
    t\u1EF1a cu\u1ED1i c\xF9ng gi\u1EEFa \u0111\u1ED1ng \u0111\u1ED5 n\xE1t c\u1EE7a
    v\u0169 tr\u1EE5.\n\nM\u1ED7i b\u01B0\u1EDBc ch\u1EA1y l\xE0 m\u1ED9t cu\u1ED9c
    \u0111\u1EA5u tr\xED v\u1EDBi t\u1EED th\u1EA7n. \u0110\u1ECBa h\xECnh d\u01B0\u1EDBi
    ch\xE2n b\u1EA1n bi\u1EBFn \u0111\u1ED5i li\xEAn t\u1EE5c, d\u1ED1c \u0111\u1EE9ng
    v\xE0 hi\u1EC3m tr\u1EDF, \u0111\xF2i h\u1ECFi b\u1EA1n ph\u1EA3i v\u1EADn d\u1EE5ng
    m\u1ECDi b\u1EA3n n\u0103ng \u0111\u1EC3 v\u01B0\u1EE3t qua. Nh\u1EEFng c\u1EA1m
    b\u1EABy ch\u1EBFt ng\u01B0\u1EDDi xu\u1EA5t hi\u1EC7n kh\u1EAFp n\u01A1i: nh\u1EEFng
    h\xE0ng gai nh\u1ECDn m\u1ECDc l\xEAn t\u1EEB k\u1EBD \u0111\xE1, nh\u1EEFng
    b\u1EC7 \u0111\xE1 rung l\u1EAFc d\u1EEF d\u1ED9i. Nh\u01B0ng nguy hi\u1EC3m
    nh\u1EA5t v\u1EABn l\xE0 b\u1EA7y qu\xE1i v\u1EADt hung h\xE3n \u0111ang v\xE2y
    h\xE3m. Ch\xFAng kh\xF4ng ch\u1EC9 \u0111\u01A1n thu\u1EA7n l\xE0 v\u1EADt c\u1EA3n,
    ch\xFAng l\xE0 nh\u1EEFng k\u1EBB s\u0103n m\u1ED3i kh\xE1t m\xE1u, xu\u1EA5t
    hi\u1EC7n t\u1EEB b\xF3ng t\u1ED1i \u0111\u1EC3 d\u1EADp t\u1EAFt hy v\u1ECDng
    c\u1EE7a b\u1EA1n. B\u1EA1n ph\u1EA3i kh\xE9o l\xE9o n\xE9 tr\xE1nh nh\u1EEFng
    \u0111\xF2n t\u1EA5n c\xF4ng t\xE0n kh\u1ED1c, s\u1EED d\u1EE5ng t\u1ED1c \u0111\u1ED9
    \u0111\u1EC3 b\u0103ng qua nh\u1EEFng k\u1EBD h\u1EDF h\u1EB9p nh\u1EA5t tr\u01B0\u1EDBc
    khi b\u1ECB ch\xFAng bao v\xE2y.\n\n\tK\xEDch th\xEDch h\u01A1n c\u1EA3 ch\xEDnh
    l\xE0 cu\u1ED9c s\u0103n t\xECm n\u0103ng l\u01B0\u1EE3ng. Gi\u1EEFa nh\u1EEFng
    hi\u1EC3m nguy, b\u1EA1n s\u1EBD t\xECm th\u1EA5y nh\u1EEFng m\u1EA3nh tinh th\u1EC3
    l\u1EA5p l\xE1nh \u2013 \u0111\xF3 l\xE0 nh\u1EEFng m\u1EA3nh linh h\u1ED3n gi\xFAp
    b\u1EA1n t\xEDch l\u0169y \u0111i\u1EC3m s\u1ED1, kh\u1EB3ng \u0111\u1ECBnh gi\xE1
    tr\u1ECB s\u1EF1 t\u1ED3n t\u1EA1i c\u1EE7a m\xECnh trong th\u1EBF gi\u1EDBi
    kh\u1EAFc nghi\u1EC7t n\xE0y. \n\tTuy nhi\xEAn, h\xE0nh tr\xECnh c\xE0ng d\xE0i,
    s\u1EE9c l\u1EF1c c\xE0ng c\u1EA1n ki\u1EC7t. Nh\u1EEFng kho\u1EA3nh kh\u1EAFc
    h\u1ED3i m\xE1u hi\u1EBFm hoi tr\u1EDF n\xEAn qu\xFD gi\xE1 h\u01A1n bao gi\u1EDD
    h\u1EBFt; ch\xFAng gi\u1ED1ng nh\u01B0 nh\u1EEFng tia hy v\u1ECDng le l\xF3i,
    gi\xFAp v\u1EBFt th\u01B0\u01A1ng kh\xE9p mi\u1EC7ng v\xE0 \u0111\xF4i ch\xE2n
    l\u1EA1i c\xF3 th\xEAm s\u1EE9c m\u1EA1nh \u0111\u1EC3 v\u01B0\u1EE3t qua nh\u1EEFng
    v\u1EF1c th\u1EB3m kh\xF4ng \u0111\xE1y.\n\n\tC\u1EA3m gi\xE1c k\xEDch th\xEDch
    \u0111\u1EA1t \u0111\u1EBFn \u0111\u1EC9nh \u0111i\u1EC3m khi b\u1EA1n \u0111\u1EE9ng
    gi\u1EEFa ranh gi\u1EDBi c\u1EE7a s\u1EF1 s\u1ED1ng v\xE0 c\xE1i ch\u1EBFt: m\u1ED9t
    b\xEAn l\xE0 b\u1EA7y qu\xE1i v\u1EADt \u0111ang g\xE0o th\xE9t s\xE1t n\xFAt,
    m\u1ED9t b\xEAn l\xE0 v\u1EF1c th\u1EB3m s\xE2u v\u1EA1n tr\u01B0\u1EE3ng c\u1EA7n
    m\u1ED9t c\xFA nh\u1EA3y chu\u1EA9n x\xE1c \u0111\u1EC3 v\u01B0\u1EE3t qua. B\u1EA1n
    kh\xF4ng ch\u1EC9 ch\u1EA1y b\u1EB1ng \u0111\xF4i ch\xE2n, b\u1EA1n \u0111ang
    ch\u1EA1y b\u1EB1ng c\u1EA3 \xFD ch\xED. \u0110i\u1EC3m s\u1ED1 c\xE0ng cao,
    danh ti\u1EBFng c\u1EE7a b\u1EA1n c\xE0ng vang xa tr\xEAn nh\u1EEFng phi\u1EBFn
    \u0111\xE1 v\u0129nh c\u1EEDu, nh\u01B0ng m\u1EE5c ti\xEAu l\u1EDBn nh\u1EA5t
    v\u1EABn l\xE0 ch\u1EA1m tay v\xE0o v\xF9ng \u0111\u1EA5t h\u1EE9a \u2013 \u0111\xEDch
    \u0111\u1EBFn cu\u1ED1i c\xF9ng \u0111\u1EC3 gi\u1EA3i m\xE3 b\xED \u1EA9n c\u1EE7a
    th\u1EBF gi\u1EDBi xa l\u1EA1 n\xE0y. H\xE3y h\xEDt m\u1ED9t h\u01A1i th\u1EADt
    s\xE2u, v\xEC trong th\u1EBF gi\u1EDBi n\xE0y, ch\u1EC9 c\u1EA7n b\u1EA1n ng\u1EEBng
    ch\u1EA1y, \u0111\u1ECBnh m\u1EC7nh c\u1EE7a b\u1EA1n s\u1EBD ch\u1EA5m d\u1EE9t."
  m_isRightToLeft: 0
